# Image for running VAJRA's demo MCP servers in Docker isolation.
#   docker build -t vajra-mcp-servers -f docker/Dockerfile.mcp docker/
# VAJRA then runs each server with: --read-only, no network (except the web fetcher),
# memory/CPU/PID limits, all capabilities dropped, no-new-privileges.
FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
RUN pip install --no-cache-dir "mcp>=2.3,<3"
RUN useradd --create-home --uid 10001 app
USER app
WORKDIR /app
